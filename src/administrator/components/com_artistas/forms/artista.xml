<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="basic" label="Datos principales">
        <field name="id" type="hidden" />
        <field name="alias" type="hidden" />

        <field name="name" type="text" label="Nombre artístico / grupo" required="true" size="60" />
        <field name="short_desc" type="text" label="Descripción corta (listado)" size="80" maxlength="500" />
        <field name="description" type="editor" label="Descripción completa" rows="8" />
        <field name="biografia" type="editor" label="Biografía" rows="10"
               hint="Historia del grupo, trayectoria, logros…" />
        <field name="influencias" type="textarea" label="Influencias musicales" rows="3" cols="60"
               hint="Ej: Dropkick Murphys, Mägo de Oz, The Pogues…" />

        <field name="genre" type="sql" label="Género musical"
               query="SELECT name AS value, name AS text FROM #__artistas_generos WHERE state=1 ORDER BY ordering ASC, name ASC"
               key_field="value" value_field="text"
               header_text="-- Seleccionar género --" header_value="">
        </field>

        <field name="provincia_origen" type="list" label="Provincia de procedencia">
            <option value="">-- Seleccionar provincia --</option>
            <option value="Álava">Álava</option>
            <option value="Albacete">Albacete</option>
            <option value="Alicante">Alicante</option>
            <option value="Almería">Almería</option>
            <option value="Asturias">Asturias</option>
            <option value="Ávila">Ávila</option>
            <option value="Badajoz">Badajoz</option>
            <option value="Barcelona">Barcelona</option>
            <option value="Burgos">Burgos</option>
            <option value="Cáceres">Cáceres</option>
            <option value="Cádiz">Cádiz</option>
            <option value="Cantabria">Cantabria</option>
            <option value="Castellón">Castellón</option>
            <option value="Ceuta">Ceuta</option>
            <option value="Ciudad Real">Ciudad Real</option>
            <option value="Córdoba">Córdoba</option>
            <option value="La Coruña">La Coruña</option>
            <option value="Cuenca">Cuenca</option>
            <option value="Girona">Girona</option>
            <option value="Granada">Granada</option>
            <option value="Guadalajara">Guadalajara</option>
            <option value="Gipuzkoa">Gipuzkoa</option>
            <option value="Huelva">Huelva</option>
            <option value="Huesca">Huesca</option>
            <option value="Islas Baleares">Islas Baleares</option>
            <option value="Jaén">Jaén</option>
            <option value="León">León</option>
            <option value="Lleida">Lleida</option>
            <option value="La Rioja">La Rioja</option>
            <option value="Lugo">Lugo</option>
            <option value="Madrid">Madrid</option>
            <option value="Málaga">Málaga</option>
            <option value="Melilla">Melilla</option>
            <option value="Murcia">Murcia</option>
            <option value="Navarra">Navarra</option>
            <option value="Ourense">Ourense</option>
            <option value="Palencia">Palencia</option>
            <option value="Las Palmas">Las Palmas</option>
            <option value="Pontevedra">Pontevedra</option>
            <option value="Salamanca">Salamanca</option>
            <option value="Santa Cruz de Tenerife">Santa Cruz de Tenerife</option>
            <option value="Segovia">Segovia</option>
            <option value="Sevilla">Sevilla</option>
            <option value="Soria">Soria</option>
            <option value="Tarragona">Tarragona</option>
            <option value="Teruel">Teruel</option>
            <option value="Toledo">Toledo</option>
            <option value="Valencia">Valencia</option>
            <option value="Valladolid">Valladolid</option>
            <option value="Vizcaya">Vizcaya</option>
            <option value="Zamora">Zamora</option>
            <option value="Zaragoza">Zaragoza</option>
        </field>

        <field name="location" type="text" label="Texto libre de localización" size="60"
               hint="Ej: Murcia, Alicante — se muestra en la ficha" />

        <field name="formats" type="checkboxes" label="Formatos de actuación">
            <option value="electrico">Eléctrico</option>
            <option value="acustico">Acústico</option>
            <option value="semiacustico">Semiacústico</option>
            <option value="itinerante">Itinerante</option>
        </field>

        <field name="events" type="checkboxes" label="Tipos de eventos">
            <option value="bodas">Bodas</option>
            <option value="bautizos">Bautizos / Comuniones</option>
            <option value="cumpleanos">Cumpleaños</option>
            <option value="corporativos">Corporativos</option>
            <option value="festivales">Festivales</option>
            <option value="medievales">Eventos medievales</option>
            <option value="privados">Conciertos privados</option>
            <option value="fiestas_patronales">Fiestas patronales</option>
            <option value="restaurantes">Restaurantes / Hoteles</option>
            <option value="inauguraciones">Inauguraciones</option>
        </field>

        <field name="created_by" type="user" label="Usuario vinculado"
               description="Usuario de Joomla propietario de esta ficha. Déjalo en 0 si no está vinculado."
               class="inputbox" />

        <field name="state" type="list" label="Estado" default="0">
            <option value="1">Publicado</option>
            <option value="0">No publicado</option>
        </field>
    </fieldset>

    <fieldset name="media" label="Multimedia">
        <field name="image" type="media" label="Foto principal" directory="artistas" />
    </fieldset>

    <fieldset name="contact" label="Contacto">
        <field name="phone"   type="tel"   label="Teléfono" size="30" />
        <field name="email"   type="email" label="Email"    size="60" />
        <field name="website" type="text"  label="Web"      size="80" />
    </fieldset>

    <fieldset name="social" label="Redes sociales">
        <field name="social_instagram" type="url" label="Instagram"
               hint="https://www.instagram.com/usuario" size="80" />
        <field name="social_facebook" type="url" label="Facebook"
               hint="https://www.facebook.com/pagina" size="80" />
        <field name="social_youtube" type="url" label="YouTube"
               hint="https://www.youtube.com/@canal" size="80" />
        <field name="solista" type="radio" label="Artista solista" default="0"
               onchange="toggleSolista(this.value)"
               class="btn-group btn-group-yesno">
            <option value="1">🎤 Sí, soy solista</option>
            <option value="0">No (banda / grupo)</option>
        </field>

        <field name="banda_principal" type="sql" label="Banda principal (de la BD)"
               query="SELECT id AS value, name AS text FROM #__artistas WHERE state=1 ORDER BY name"
               header="-- Ninguna (solista) --"
               header_value=""
               class="chzn-color" />

        <field name="banda_texto" type="text" label="Banda (texto libre)"
               hint="Si la banda no está en la base de datos" size="60" />

        <field name="tipo_banda" type="list" label="Tipo de banda / solista" default="propias" onchange="toggleSolista(this.value)">
            <option value="solista">🎤 Solista</option>
            <option value="propias">🎵 Canciones propias</option>
            <option value="versiones">🎸 Versiones</option>
            <option value="ambas">🎶 Propias y versiones</option>
        </field>

        <field name="social_tiktok" type="url" label="TikTok"
               hint="https://www.tiktok.com/@usuario" size="80" />
    </fieldset>

    <fieldset name="metadata" label="SEO">
        <field name="metadesc" type="textarea" label="Meta descripción" rows="3" cols="60" />
        <field name="metakey"  type="textarea" label="Meta palabras clave" rows="3" cols="60" />
    </fieldset>
    <fieldset name="musico" label="Datos del músico">
        <field name="banda_id" type="sql" label="Banda principal (de la BD)"
               query="SELECT id AS value, name AS text FROM #__artistas WHERE state=1 ORDER BY name"
               header="-- Ninguna --" header_value="" class="form-select" />

        <field name="banda_texto" type="text" label="Banda (texto libre)"
               hint="Si la banda no está en la base de datos" size="60"
               description="Si la banda no está en la base de datos" />

        <field name="solista" type="checkbox" label="Solista" value="1" default="0" />

        <field name="instrumento" type="text" label="Instrumento(s)"
               hint="Ej: Guitarra, Bajo, Voz, Batería..." size="60" />

        <field name="pais_origen" type="text" label="País de origen" size="40" />

        <field name="fecha_nacimiento" type="calendar" label="Fecha de nacimiento"
               format="%Y-%m-%d" filter="user_utc" />

        <field name="lugar_nacimiento" type="text" label="Lugar de nacimiento" size="60" />

        <field name="vive" type="checkbox" label="Todavía vive" value="1" default="1" />

        <field name="fecha_defuncion" type="calendar" label="Fecha de defunción"
               format="%Y-%m-%d" filter="user_utc" />

        <field name="lugar_defuncion" type="text" label="Lugar de defunción" size="60" />

        <field name="wikipedia_url" type="url" label="Wikipedia URL" size="80" />
    </fieldset>
</form>
