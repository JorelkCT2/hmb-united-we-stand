<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>mod_hmb_videos</name>
    <author>Heavy Metal Brothers</author>
    <authorEmail>admin@heavymetalbrothers.com</authorEmail>
    <authorUrl>https://www.heavymetalbrothers.com</authorUrl>
    <creationDate>2024</creationDate>
    <version>1.0.0</version>
    <description>MOD_HMB_VIDEOS_DESC</description>

    <namespace path="src">Joomla\Module\HmbVideos</namespace>

    <files>
        <filename module="mod_hmb_videos">mod_hmb_videos.php</filename>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/mod_hmb_videos.ini</language>
        <language tag="en-GB">en-GB/mod_hmb_videos.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="MOD_HMB_VIDEOS_PARAMS_BASIC">
                <field name="folder_id" type="sql"
                    label="MOD_HMB_VIDEOS_PARAM_FOLDER"
                    query="SELECT id, title FROM #__hmb_folders WHERE state=1 ORDER BY title ASC"
                    key_field="id" value_field="title"
                    first_option="MOD_HMB_VIDEOS_ALL_FOLDERS"
                    class="form-select" />
                <field name="limit" type="number" label="MOD_HMB_VIDEOS_PARAM_LIMIT" default="6" min="1" max="24" class="form-control" />
                <field name="show_featured_only" type="list" label="MOD_HMB_VIDEOS_PARAM_FEATURED_ONLY" default="0" class="form-select">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="ordering" type="list" label="MOD_HMB_VIDEOS_PARAM_ORDERING" default="ordering" class="form-select">
                    <option value="ordering">MOD_HMB_VIDEOS_ORDER_MANUAL</option>
                    <option value="id">MOD_HMB_VIDEOS_ORDER_NEWEST</option>
                    <option value="hits">MOD_HMB_VIDEOS_ORDER_POPULAR</option>
                    <option value="rand">MOD_HMB_VIDEOS_ORDER_RANDOM</option>
                </field>
                <field name="layout_style" type="list" label="MOD_HMB_VIDEOS_PARAM_LAYOUT" default="grid" class="form-select">
                    <option value="grid">MOD_HMB_VIDEOS_LAYOUT_GRID</option>
                    <option value="list">MOD_HMB_VIDEOS_LAYOUT_LIST</option>
                </field>
                <field name="show_title" type="list" label="MOD_HMB_VIDEOS_PARAM_SHOW_TITLE" default="1" class="form-select">
                    <option value="1">JYES</option><option value="0">JNO</option>
                </field>
                <field name="show_band" type="list" label="MOD_HMB_VIDEOS_PARAM_SHOW_BAND" default="1" class="form-select">
                    <option value="1">JYES</option><option value="0">JNO</option>
                </field>
                <field name="show_view_all" type="list" label="MOD_HMB_VIDEOS_PARAM_SHOW_VIEW_ALL" default="1" class="form-select">
                    <option value="1">JYES</option><option value="0">JNO</option>
                </field>
                <field name="view_all_itemid" type="menuitem" label="MOD_HMB_VIDEOS_PARAM_VIEW_ALL_MENU" class="form-select" />
            </fieldset>
        </fields>
    </config>
</extension>
