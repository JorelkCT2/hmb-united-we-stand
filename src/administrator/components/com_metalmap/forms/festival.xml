<?xml version="1.0" encoding="utf-8"?>
<form>
    <field
        name="id"
        type="number"
        label="JGRID_HEADING_ID"
        default="0"
        class="readonly"
        readonly="true"
    />

    <field
        name="name"
        type="text"
        label="COM_METALMAP_FIELD_NAME"
        required="true"
        size="50"
        filter="string"
    />

    <field
        name="alias"
        type="text"
        label="JFIELD_ALIAS_LABEL"
        description="JFIELD_ALIAS_DESC"
        hint="JFIELD_ALIAS_PLACEHOLDER"
        filter="cmd"
    />

    <field
        name="event_type"
        type="list"
        label="COM_METALMAP_FIELD_EVENT_TYPE"
        default="festival"
    >
        <option value="festival">COM_METALMAP_TYPE_FESTIVAL</option>
        <option value="concert">COM_METALMAP_TYPE_CONCERT</option>
    </field>

    <field
        name="description"
        type="editor"
        label="COM_METALMAP_FIELD_DESCRIPTION"
        filter="safehtml"
        buttons="true"
        rows="6"
    />

    <field
        name="bands"
        type="textarea"
        label="COM_METALMAP_FIELD_BANDS"
        description="COM_METALMAP_FIELD_BANDS_DESC"
        rows="3"
        filter="string"
    />

    <field
        name="start_date"
        type="calendar"
        label="COM_METALMAP_FIELD_START_DATE"
        format="%Y-%m-%d"
        filter="user_utc"
    />

    <field
        name="end_date"
        type="calendar"
        label="COM_METALMAP_FIELD_END_DATE"
        format="%Y-%m-%d"
        filter="user_utc"
    />

    <field
        name="city"
        type="text"
        label="COM_METALMAP_FIELD_CITY"
        filter="string"
    />

    <field
        name="country"
        type="text"
        label="COM_METALMAP_FIELD_COUNTRY"
        filter="string"
    />

    <field
        name="country_code"
        type="text"
        label="COM_METALMAP_FIELD_COUNTRY_CODE"
        description="COM_METALMAP_FIELD_COUNTRY_CODE_DESC"
        size="4"
        maxlength="2"
        hint="es, de, fi, no..."
        filter="cmd"
    />

    <field
        name="latitude"
        type="text"
        label="COM_METALMAP_FIELD_LATITUDE"
        description="COM_METALMAP_FIELD_LATITUDE_DESC"
        required="true"
        size="20"
        default="0"
        filter="float"
    />

    <field
        name="longitude"
        type="text"
        label="COM_METALMAP_FIELD_LONGITUDE"
        description="COM_METALMAP_FIELD_LONGITUDE_DESC"
        required="true"
        size="20"
        default="0"
        filter="float"
    />

    <field
        name="website"
        type="url"
        label="COM_METALMAP_FIELD_WEBSITE"
        description="COM_METALMAP_FIELD_WEBSITE_DESC"
        filter="url"
        size="50"
    />

    <field
        name="state"
        type="list"
        label="JSTATUS"
        default="1"
        class="form-select-color-state"
    >
        <option value="1">JPUBLISHED</option>
        <option value="0">JUNPUBLISHED</option>
        <option value="-2">JTRASHED</option>
    </field>
</form>
