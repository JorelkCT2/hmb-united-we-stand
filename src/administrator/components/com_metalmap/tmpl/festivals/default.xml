<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="JSEARCH_FILTER"
            description="COM_METALMAP_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />

        <field
            name="state"
            type="list"
            label="JSTATUS"
            onchange="this.form.submit();"
            default=""
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="event_type"
            type="list"
            label="COM_METALMAP_FIELD_EVENT_TYPE"
            onchange="this.form.submit();"
            default=""
        >
            <option value="">COM_METALMAP_FILTER_TYPE_ALL</option>
            <option value="festival">COM_METALMAP_TYPE_FESTIVAL</option>
            <option value="concert">COM_METALMAP_TYPE_CONCERT</option>
        </field>

        <field
            name="country"
            type="text"
            label="COM_METALMAP_FIELD_COUNTRY_CODE"
            description="COM_METALMAP_FILTER_COUNTRY_DESC"
            hint="ES, DE, FI..."
        />
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.start_date ASC"
            onchange="this.form.submit();"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.name ASC">COM_METALMAP_FIELD_NAME ↑</option>
            <option value="a.name DESC">COM_METALMAP_FIELD_NAME ↓</option>
            <option value="a.start_date ASC">COM_METALMAP_FIELD_START_DATE ↑</option>
            <option value="a.start_date DESC">COM_METALMAP_FIELD_START_DATE ↓</option>
            <option value="a.country ASC">COM_METALMAP_FIELD_COUNTRY ↑</option>
            <option value="a.id DESC">JGRID_HEADING_ID ↓</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            onchange="this.form.submit();"
        />
    </fields>
</form>
