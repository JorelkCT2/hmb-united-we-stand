<?xml version="1.0" encoding="UTF-8"?>
<form>
    <field name="id" type="hidden" />

    <field
        name="titulo"
        type="text"
        label="Título"
        description="Título descriptivo de la efeméride"
        required="true"
        maxlength="500"
        class="form-control"
    />

    <field
        name="fecha_evento"
        type="calendar"
        label="Fecha del evento"
        description="Fecha original del evento histórico"
        required="true"
        format="%Y-%m-%d"
        filter="date"
        class="form-control"
    />

    <field
        name="categoria_id"
        type="sql"
        label="Categoría"
        query="SELECT id AS value, name AS text FROM #__efemerides_categorias WHERE state=1 ORDER BY ordering ASC"
        key_field="value"
        value_field="text"
        class="form-select"
    />

    <field
        name="artista"
        type="text"
        label="Artista / Banda"
        description="Nombre del artista o grupo musical"
        maxlength="255"
        class="form-control"
    />

    <field
        name="descripcion"
        type="textarea"
        label="Descripción breve"
        description="Resumen corto del evento (para el frontend)"
        rows="4"
        class="form-control"
    />

    <field
        name="detalle"
        type="editor"
        label="Detalle completo"
        description="Descripción detallada del evento"
        filter="safehtml"
    />

    <field
        name="nombre_disco"
        type="text"
        label="Nombre del disco"
        description="Solo para lanzamientos de discos"
        maxlength="255"
        class="form-control"
    />

    <field
        name="lugar_concierto"
        type="text"
        label="Lugar del concierto"
        description="Ciudad, sala o estadio (solo para conciertos)"
        maxlength="255"
        class="form-control"
    />

    <field
        name="asistentes"
        type="number"
        label="Asistentes"
        description="Número de asistentes al concierto"
        min="0"
        class="form-control"
    />

    <field
        name="state"
        type="list"
        label="Estado"
        class="form-select"
    >
        <option value="1">Publicado</option>
        <option value="0">Despublicado</option>
    </field>
</form>
