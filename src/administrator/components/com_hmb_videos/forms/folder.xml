<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details">
        <field name="id" type="hidden" />
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true" class="form-control" />
        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" hint="JFIELD_ALIAS_PLACEHOLDER" class="form-control" />
        <field name="parent_id" type="sql"
            label="COM_HMB_VIDEOS_FOLDER_PARENT"
            query="SELECT id, title FROM #__hmb_folders WHERE state=1 ORDER BY title ASC"
            key_field="id" value_field="title"
            first_option="COM_HMB_VIDEOS_FOLDER_ROOT_OPTION"
            class="form-select" />
        <field name="description" type="editor" label="JGLOBAL_DESCRIPTION" rows="4" />
        <field name="cover_image" type="text" label="COM_HMB_VIDEOS_FOLDER_COVER_IMAGE" class="form-control" />
        <field name="state" type="list" label="JSTATUS" default="1" class="form-select">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
        <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" class="form-select" />
        <field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" class="form-control" />
    </fieldset>
</form>
