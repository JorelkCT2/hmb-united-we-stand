<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_HMB_USERBAR</name>
    <author>Heavy Metal Brothers</author>
    <version>1.0.1</version>
    <description>MOD_HMB_USERBAR_DESC</description>

    <files>
        <filename module="mod_hmb_userbar">mod_hmb_userbar.php</filename>
        <folder>tmpl</folder>
    </files>

    <media destination="mod_hmb_userbar" folder="media">
        <folder>css</folder>
    </media>

    <languages folder="language">
        <language tag="en-GB">en-GB/mod_hmb_userbar.ini</language>
        <language tag="es-ES">es-ES/mod_hmb_userbar.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="profile_url" type="url"
                    label="MOD_HMB_USERBAR_PROFILE_URL"
                    default="" filter="url" />
                <field name="login_url" type="url"
                    label="MOD_HMB_USERBAR_LOGIN_URL"
                    default="" filter="url" />
            </fieldset>
        </fields>
    </config>
</extension>
