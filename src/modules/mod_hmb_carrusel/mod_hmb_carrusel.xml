                <field name="f9_url" type="text" label="URL externa" filter="url" size="60" />
                <field name="f9_titulo" type="text" label="Título" filter="string" size="60" />
            </fieldset>

            <!-- ═══ FOTO 10 ═══ -->
            <fieldset name="foto10" label="Foto 10">
                <field name="f10_media" type="media" label="Archivo" preview="true" types="images" />
                <field name="f10_url" type="text" label="URL externa" filter="url" size="60" />
                <field name="f10_titulo" type="text" label="Título" filter="string" size="60" />
            </fieldset>

        </fields>
    </config>
</extension>
