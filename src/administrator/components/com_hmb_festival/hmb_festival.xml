<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_hmb_festival</name>
	<author>Heavy Metal Brothers</author>
	<creationDate>2026</creationDate>
	<copyright>(C) Heavy Metal Brothers</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>0.3.0</version>
	<description>COM_HMB_FESTIVAL_XML_DESCRIPTION</description>
	<namespace path="src">Hmb\Component\Festival</namespace>

	<scriptfile>script.php</scriptfile>

	<install>
		<sql>
			<file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8mb4">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

	<!-- SITE (frontend) -->
	<files folder="components/com_hmb_festival">
		<folder>services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<media destination="com_hmb_festival" folder="media/com_hmb_festival">
		<folder>js</folder>
		<folder>css</folder>
	</media>

	<languages folder="language">
		<language tag="es-ES">es-ES/com_hmb_festival.ini</language>
	</languages>

	<administration>
		<menu link="option=com_hmb_festival">COM_HMB_FESTIVAL</menu>

		<files folder="administrator/components/com_hmb_festival">
			<folder>services</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
			<file>access.xml</file>
			<file>config.xml</file>
		</files>

		<languages folder="administrator/language">
			<language tag="es-ES">es-ES/com_hmb_festival.ini</language>
			<language tag="es-ES">es-ES/com_hmb_festival.sys.ini</language>
		</languages>
	</administration>
</extension>
