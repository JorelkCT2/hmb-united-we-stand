<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_hmb_pwa</name>
	<author>Heavy Metal Brothers</author>
	<creationDate>2026</creationDate>
	<version>1.0.0</version>
	<description>PLG_SYSTEM_HMB_PWA_XML_DESCRIPTION</description>
	<namespace path="src">Hmb\Plugin\System\HmbPwa</namespace>

	<files>
		<folder plugin="hmb_pwa">services</folder>
		<folder>src</folder>
		<folder>language</folder>
	</files>

	<media destination="plg_system_hmb_pwa" folder="media">
		<filename>manifest.webmanifest</filename>
		<filename>offline.html</filename>
		<folder>icons</folder>
	</media>

	<languages folder="language">
		<language tag="es-ES">es-ES/plg_system_hmb_pwa.ini</language>
		<language tag="es-ES">es-ES/plg_system_hmb_pwa.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="app_title" type="text" default="Metal Quiz"
					label="PLG_SYSTEM_HMB_PWA_TITLE" description="PLG_SYSTEM_HMB_PWA_TITLE_DESC" />

				<field name="theme_color" type="color" default="#c1121f"
					label="PLG_SYSTEM_HMB_PWA_THEME" description="PLG_SYSTEM_HMB_PWA_THEME_DESC" />

				<field name="spacer1" type="note" label="PLG_SYSTEM_HMB_PWA_NOTE_LABEL" description="PLG_SYSTEM_HMB_PWA_NOTE_DESC" />
			</fieldset>
		</fields>
	</config>
</extension>
