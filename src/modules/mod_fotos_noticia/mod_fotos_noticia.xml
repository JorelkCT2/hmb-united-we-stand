<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="4.0" client="site" method="upgrade">
    <name>mod_fotos_noticia</name>
    <title>Fotos Automáticas para Noticias</title>
    <description>Módulo que detecta automáticamente la fecha del artículo y muestra las fotos correspondientes.</description>
    <version>2.0.0</version>
    <author>Francisco &amp; Copilot</author>

    <files>
        <filename module="mod_fotos_noticia">mod_fotos_noticia.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
        <folder>media</folder>
    </files>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field 
                    name="basefolder" 
                    type="text" 
                    label="Carpeta base" 
                    default="noticias"
                />
                <field 
                    name="maximages" 
                    type="number" 
                    label="Número máximo de fotos" 
                    default="3"
                />
            </fieldset>
        </fields>
    </config>
</extension>
