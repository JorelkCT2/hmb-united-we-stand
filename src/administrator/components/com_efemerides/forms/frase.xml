<?xml version="1.0" encoding="UTF-8"?>
<form>
    <field name="id" type="hidden" />
    <field name="musico_id" type="hidden" default="" filter="int" />
    <field name="fecha_nacimiento" type="hidden" default="" filter="string" />
    <field name="fecha_defuncion"  type="hidden" default="" filter="string" />
    <field name="frase" type="textarea" label="Frase" required="true" rows="5" class="form-control"
           description="Escribe la frase mítica." />
    <field name="autor" type="sql"
           label="Autor"
           description="Selecciona el músico de la base de datos."
           required="true"
           query="SELECT id AS value, nombre AS text FROM #__efemerides_musicos WHERE state=1 ORDER BY nombre ASC"
           key_field="value"
           value_field="text"
           first_option="-- Selecciona un músico --"
           first_option_value=""
           class="form-select"
           filter="string" />
    <field name="state" type="list" label="Publicado" class="form-select">
        <option value="1">Sí</option>
        <option value="0">No</option>
    </field>
</form>
