<?xml version="1.0" encoding="utf-8"?>
<extension version="6.0" type="module" client="site" method="upgrade">
    <name>mod_bannerswitcherpro</name>
    <title>HMB Banner Switcher Pro</title>
    <description>Slider Heavy Metal Brothers — hasta 10 banners, imágenes Desktop y Mobile, apertura en misma/nueva ventana por slide, Ken Burns, autoplay y dots de calavera.</description>
    <version>3.1.0</version>
    <author>Heavy Metal Brothers</author>
    <creationDate>2026</creationDate>

    <files>
        <filename module="mod_bannerswitcherpro">mod_bannerswitcherpro.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
    </files>

    <media destination="mod_bannerswitcherpro" folder="media">
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <config>
        <fields name="params">

            <!-- ══ GENERAL ══════════════════════════════════════════ -->
            <fieldset name="general" label="Configuración general">

                <field name="autoplay"
                       type="radio"
                       label="Autoplay"
                       default="1"
                       layout="joomla.form.field.radio.switcher">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field name="interval"
                       type="number"
                       label="Intervalo entre slides (ms)"
                       description="Ej: 4500 = 4,5 segundos"
                       default="4500"
                       min="1000"
                       max="15000"
                       step="500" />

                <field name="link_target"
                       type="list"
                       label="Apertura de enlace global"
                       description="Se aplica a todos los slides que no tengan un ajuste propio"
                       default="_self">
                    <option value="_self">Misma ventana</option>
                    <option value="_blank">Nueva ventana / pestaña</option>
                </field>

                <field name="banner_height"
                       type="list"
                       label="Alto del banner (desktop)"
                       default="200">
                    <option value="80">Pequeño — 80px</option>
                    <option value="120">Compacto — 120px</option>
                    <option value="160">Mediano — 160px</option>
                    <option value="200">Normal — 200px</option>
                    <option value="260">Grande — 260px</option>
                    <option value="320">Muy grande — 320px</option>
                    <option value="400">Gigante — 400px</option>
                    <option value="0">Sin límite (tamaño natural)</option>
                </field>

                <field name="banner_height_mobile"
                       type="list"
                       label="Alto del banner (móvil)"
                       default="96">
                    <option value="60">Pequeño — 60px</option>
                    <option value="100">Compacto — 100px</option>
                    <option value="120">Normal — 120px</option>
                    <option value="160">Grande — 160px</option>
                    <option value="200">Muy grande — 200px</option>
                    <option value="0">Sin límite (tamaño natural)</option>
                </field>

                <field name="object_fit"
                       type="list"
                       label="Ajuste de imagen"
                       description="Cover rellena todo el espacio. Contain muestra la imagen completa."
                       default="cover">
                    <option value="cover">Cover (rellena, puede recortar)</option>
                    <option value="contain">Contain (imagen completa, con espacios)</option>
                </field>

            </fieldset>

            <!-- ══ SLIDE 1 ══════════════════════════════════════════ -->
            <fieldset name="slide1" label="Banner 1">
                <field name="desktop1" type="media" label="Imagen Desktop" />
                <field name="mobile1"  type="media" label="Imagen Mobile (opcional)" />
                <field name="link1"    type="url"   label="Enlace" default="" filter="url" />
                <field name="target1"  type="list"  label="Abrir enlace en" default="">
                    <option value="">— Global (usa ajuste general)</option>
                    <option value="_self">Misma ventana</option>
                    <option value="_blank">Nueva ventana / pestaña</option>
                </field>
            </fieldset>

            <!-- ══ SLIDE 2 ══════════════════════════════════════════ -->
