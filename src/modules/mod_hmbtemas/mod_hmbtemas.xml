<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>mod_hmbtemas</name>
    <author>Heavy Metal Brothers</author>
    <version>1.0.0</version>
    <description>Muestra la lista de temas musicales de HMB.</description>
    <namespace path="src">HeavyMetalBrothers\Module\HmbTemas</namespace>

    <files>
        <filename module="mod_hmbtemas">mod_hmbtemas.php</filename>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <config>
        <fields name="params">
            <fieldset name="basic" label="Opciones">

                <field name="titulo" type="text"
                       label="Título de la sección"
                       default="Nuestros Temas" />

                <field name="subtitulo" type="text"
                       label="Subtítulo"
                       default="" />

                <field name="orden" type="list"
                       label="Ordenar por"
                       default="album_year ASC,track_number ASC">
                    <option value="album_year ASC,track_number ASC">Álbum y pista (A→Z)</option>
                    <option value="album_year DESC,track_number ASC">Álbum más reciente primero</option>
                    <option value="title ASC">Título (A→Z)</option>
                </field>

                <field name="mostrar_spotify" type="list"
                       label="Mostrar enlace Spotify" default="1">
                    <option value="1">Sí</option>
                    <option value="0">No</option>
                </field>

                <field name="mostrar_youtube" type="list"
                       label="Mostrar enlace YouTube" default="1">
                    <option value="1">Sí</option>
                    <option value="0">No</option>
                </field>

                <field name="mostrar_player" type="list"
                       label="Mostrar reproductor" default="1">
                    <option value="1">Sí</option>
                    <option value="0">No</option>
                </field>

            </fieldset>
        </fields>
    </config>
</extension>
